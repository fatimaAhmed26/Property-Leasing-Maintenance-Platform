@model PropertyLeasing.API.Models.AppUser
@using PropertyLeasing.API.Models
@{
    ViewData["Title"] = "My Profile";
    var tenant = ViewBag.Tenant as Tenant;
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <h2 class="fw-bold mb-4">My Profile</h2>

        <div class="apple-card mb-4">
            <h5 class="fw-bold mb-4">Account Details</h5>
            <div class="row border-bottom py-2 mx-0">
                <div class="col-4 text-muted fw-semibold px-0">Full Name</div>
                <div class="col-8 text-dark text-end px-0">@Model.FullName</div>
            </div>
            <div class="row border-bottom py-2 mx-0">
                <div class="col-4 text-muted fw-semibold px-0">Email</div>
                <div class="col-8 text-dark text-end px-0">@Model.Email</div>
            </div>
            <div class="row py-2 mx-0">
                <div class="col-4 text-muted fw-semibold px-0">Role</div>
                <div class="col-8 text-end px-0">
                    @{
                        var roles = ViewContext.HttpContext.User;
                        string role = roles.IsInRole("Property Manager") ? "Property Manager"
                        : roles.IsInRole("Maintenance Staff") ? "Maintenance Staff"
                        : "Tenant";
                    }
                    <span class="badge text-blue" style="background-color: #eef5ff;">@role</span>
                </div>
            </div>
        </div>

        @if (tenant != null)
        {
            <div class="apple-card">
                <h5 class="fw-bold mb-3">Tenant Details</h5>

                <div class="mb-4">
                    <div class="text-muted small">Tenant ID</div>
                    <div class="fw-semibold text-dark">#@tenant.TenantId</div>
                </div>

                <div class="mb-4">
                    <div class="text-muted small">Registered Phone Number</div>
                    <p class="text-muted small">This number is used for maintenance tracking.</p>

                    <div id="phoneDisplay" class="d-flex align-items-center justify-content-between mt-2">
                        <span class="fw-semibold fs-5">@tenant.Phone</span>
                        <button type="button" class="btn-apple-secondary btn-sm" onclick="toggleEdit()">Edit</button>
                    </div>

                    <form id="phoneForm" asp-action="UpdatePhone" method="post" class="d-none mt-2">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <input type="text" name="phone" value="@tenant.Phone" class="form-control" required />
                            <button type="submit" class="btn-apple">Save</button>
                            <button type="button" class="btn-apple-secondary" onclick="toggleEdit()">Cancel</button>
                        </div>
                    </form>
                </div>

                <div class="pt-3 border-top text-center">
                    <a asp-controller="PublicLookup" asp-action="MaintenanceLookup" class="text-blue fw-semibold text-decoration-none">
                        &#128269; Track a Maintenance Request
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function toggleEdit() {
        document.getElementById('phoneDisplay').classList.toggle('d-none');
        document.getElementById('phoneForm').classList.toggle('d-none');
    }
</script>