@model IEnumerable<PropertyLeasing.API.Models.Application>
@using PropertyLeasing.API.Services
@{
    ViewData["Title"] = "Lease Workflow";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Lease Workflow</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="apple-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Property</th>
                <th>Submitted</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>#@a.ApplicationId</td>
                    <td>@a.Tenant?.FullName</td>
                    <td>@a.Unit?.UnitNumber</td>
                    <td>@a.Unit?.Property?.PropertyName</td>
                    <td>@a.SubmittedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        @{
                            var badgeClass = a.Status switch
                            {
                                ApplicationStatuses.Approved => "text-green",
                                ApplicationStatuses.Rejected => "text-red",
                                ApplicationStatuses.Screening => "text-blue",
                                ApplicationStatuses.LeaseActive => "text-purple",
                                ApplicationStatuses.Renewed => "text-purple",
                                ApplicationStatuses.Terminated => "text-red",
                                _ => "text-muted"
                            };
                        }
                        <span class="badge @badgeClass">@a.Status</span>
                    </td>
                    <td>
                        @if (a.Status == ApplicationStatuses.Submitted || a.Status == ApplicationStatuses.Pending)
                        {
                            <form asp-action="MoveToScreening" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@a.ApplicationId" />
                                <button class="btn-apple-outline btn-sm py-1">Screen</button>
                            </form>
                        }
                        @if (a.Status == ApplicationStatuses.Screening)
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@a.ApplicationId" />
                                <button class="btn-apple btn-sm py-1">Approve</button>
                            </form>
                            <form asp-action="Reject" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@a.ApplicationId" />
                                <button class="btn-apple-outline btn-sm py-1 text-red btn-reject-hover" style="border-color: #ff375f;">Reject</button>
                            </form>
                        }
                        @if (a.Status == ApplicationStatuses.Approved)
                        {
                            <button class="btn-apple btn-sm py-1" data-bs-toggle="modal"
                                    data-bs-target="#activateModal_@a.ApplicationId">
                                Activate Lease
                            </button>

                            <div class="modal fade" id="activateModal_@a.ApplicationId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content" style="border-radius: var(--radius-lg); border: none; box-shadow: var(--shadow-lg);">
                                        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                                            <h5 class="modal-title fw-bold">Activate Lease #@a.ApplicationId</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-action="Activate" method="post">
                                            <div class="modal-body">
                                                <input type="hidden" name="id" value="@a.ApplicationId" />
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Start Date</label>
                                                    <input type="date" name="startDate" class="form-control" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">End Date</label>
                                                    <input type="date" name="endDate" class="form-control" required />
                                                </div>
                                                <p class="text-muted small mt-2">Monthly rent: <strong class="text-blue">@a.Unit?.RentAmount.ToString("C")</strong></p>
                                            </div>
                                            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                                                <button type="button" class="btn-apple-outline" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn-apple">Activate</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No applications found.</td></tr>
            }
        </tbody>
    </table>
</div>