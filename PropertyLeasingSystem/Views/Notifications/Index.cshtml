@model IEnumerable<PropertyLeasing.API.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Notifications</h2>
        @if (unreadCount > 0)
        {
            <span class="badge" style="background-color: var(--apple-blue); color: #fff;">@unreadCount unread</span>
        }
    </div>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn-apple-outline btn-sm">Mark all as read</button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <div class="fs-1 mb-2">&#128276;</div>
        <p>You have no notifications.</p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var n in Model)
        {
            <div class="apple-card p-3 d-flex justify-content-between align-items-center @(!n.IsRead ? "border-primary" : "")"
                 style="@(!n.IsRead ? "border: 1px solid var(--apple-blue);" : "")">

                <div class="d-flex gap-3 align-items-start">
                    <span class="mt-1">
                        @if (!n.IsRead)
                        {
                            <span class="text-blue">&#9679;</span>
                        }
                        else
                        {
                            <span class="text-muted">&#9675;</span>
                        }
                    </span>
                    <div>
                        <div class="fw-semibold @(n.IsRead ? "text-muted" : "text-dark")">@n.Message</div>
                        <small class="text-muted" style="font-size: 0.75rem;">@n.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                    </div>
                </div>

                @if (!n.IsRead)
                {
                    <form asp-action="MarkRead" method="post" class="ms-3 flex-shrink-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@n.NotificationId" />
                        <button class="btn-apple-outline btn-sm py-1 px-3">Mark read</button>
                    </form>
                }
            </div>
        }
    </div>
}