@model IEnumerable<PropertyLeasing.API.Models.Lease>
@{
    ViewData["Title"] = "Payments";
    var overdueIds = ViewBag.OverdueLeaseIds as HashSet<int> ?? new HashSet<int>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Active Leases & Payments</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="apple-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Lease ID</th>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Monthly Rent</th>
                <th>Payments</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model)
            {
                var isOverdue = overdueIds.Contains(l.LeaseId);
                <tr class="@(isOverdue)">
                    <td><strong>#@l.LeaseId</strong></td>
                    <td>@l.Tenant?.FullName</td>
                    <td class="text-blue fw-semibold">@l.Unit?.UnitNumber</td>
                    <td>@l.MonthlyRent.ToString("C")</td>
                    <td class="text-muted">@(l.Payments?.Count ?? 0) payments</td>
                    <td>
                        <span class="badge @(isOverdue ? "text-red" : "text-green")">
                            @(isOverdue ? "Overdue" : l.Status)
                        </span>
                    </td>
                    <td>
                        <a asp-action="LeasePayments" asp-route-leaseId="@l.LeaseId" class="btn-apple-outline text-decoration-none btn-sm py-1">View History</a>
                        <button class="btn-apple btn-sm py-1" data-bs-toggle="modal" data-bs-target="#payModal_@l.LeaseId">Record Payment</button>

                        <div class="modal fade" id="payModal_@l.LeaseId" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content" style="border-radius: var(--radius-lg); border: none;">
                                    <div class="modal-header"><h5 class="modal-title fw-bold">Record Payment - #@l.LeaseId</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                                    <form asp-action="RecordPayment" method="post">
                                        <div class="modal-body">
                                            <input type="hidden" name="leaseId" value="@l.LeaseId" />
                                            <div class="mb-3"><label class="form-label fw-semibold">Amount</label><input type="number" name="amount" class="form-control" step="0.01" value="@l.MonthlyRent" required /></div>
                                            <div class="mb-3"><label class="form-label fw-semibold">Payment Method</label><select name="method" class="form-select"><option>Cash</option><option>Bank Transfer</option><option>Credit Card</option><option>Cheque</option></select></div>
                                            <div class="mb-3"><label class="form-label fw-semibold">Payment Type</label><select name="paymentType" class="form-select"><option value="Rent">Rent</option><option value="Deposit">Deposit</option><option value="Late Fee">Late Fee</option></select></div>
                                        </div>
                                        <div class="modal-footer"><button type="button" class="btn-apple-outline" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn-apple">Record</button></div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>