@model PropertyLeasing.API.Models.Lease
@{
    ViewData["Title"] = $"Payments - Lease #{Model.LeaseId}";
    var isOverdue = (bool)(ViewBag.IsOverdue ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Lease #@Model.LeaseId Payment History</h2>
        <p class="text-muted">
            @Model.Tenant?.FullName &mdash; Unit @Model.Unit?.UnitNumber &mdash;
            @Model.StartDate.ToString("MMM d, yyyy") to @Model.EndDate.ToString("MMM d, yyyy")
        </p>
    </div>
    <a asp-action="Index" class="btn-apple-outline">Back</a>
</div>

@if (isOverdue)
{
    <div class="alert alert-danger mb-4"><strong>Overdue!</strong> This lease has outstanding rent payments.</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="apple-card text-center p-3">
            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Monthly Rent</div>
            <div class="fs-4 fw-bold text-dark">@Model.MonthlyRent.ToString("C")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="apple-card text-center p-3">
            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Total Paid</div>
            <div class="fs-4 fw-bold text-green">@((Model.Payments?.Sum(p => p.Amount) ?? 0).ToString("C"))</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="apple-card text-center p-3">
            <div class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Payment Count</div>
            <div class="fs-4 fw-bold text-blue">@(Model.Payments?.Count ?? 0)</div>
        </div>
    </div>
</div>

<div class="apple-table">
    <table class="table mb-0">
        <thead>
            <tr>
                <th>Payment ID</th>
                <th>Date & Time</th>
                <th>Amount</th>
                <th>Method</th>
                <th>Type</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Payments ?? new List<PropertyLeasing.API.Models.Payment>())
            {
                <tr>
                    <td><strong>#@p.PaymentId</strong></td>
                    <td class="text-muted">@p.PaymentDate.ToString("MMM d, yyyy, h:mm tt")</td>
                    <td class="fw-bold">@p.Amount.ToString("C")</td>
                    <td>@p.Method</td>
                    <td>@p.PaymentType</td>
                    <td>
                        <span class="badge @(p.Status == "Paid" ? "text-green" : "text-red")">
                            @p.Status
                        </span>
                    </td>
                </tr>
            }
            @if (!(Model.Payments?.Any() ?? false))
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No payments recorded yet.</td></tr>
            }
        </tbody>
    </table>
</div>