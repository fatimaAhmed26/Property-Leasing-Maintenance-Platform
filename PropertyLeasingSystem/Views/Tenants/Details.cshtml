@model PropertyLeasing.API.Models.Tenant
@{ ViewData["Title"] = $"Tenant - {Model.FullName}"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.FullName</h2>
    <a asp-action="Index" class="btn-apple-secondary text-decoration-none">Back to Tenants</a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="apple-card h-100">
            <h5 class="fw-bold mb-3">Contact Info</h5>
            <div class="mb-3">
                <div class="text-muted small">Email</div>
                <div class="fw-semibold">@Model.Email</div>
            </div>
            <div>
                <div class="text-muted small">Phone</div>
                <div class="fw-semibold">@Model.Phone</div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="apple-card">
            <h5 class="fw-bold mb-3">Active Leases</h5>
            @if (Model.Leases?.Any() == true) {
                @foreach (var l in Model.Leases) {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <div><strong>Unit @l.Unit?.UnitNumber</strong> <span class="badge text-green ms-2">@l.Status</span></div>
                        <small class="text-muted">@l.StartDate.ToString("MMM yyyy") - @l.EndDate.ToString("MMM yyyy")</small>
                    </div>
                }
            } else { <p class="text-muted small">No active leases found.</p> }
        </div>
    </div>

    <div class="col-12">
        <h5 class="fw-bold mb-3">Maintenance History</h5>
        <div class="apple-table">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="px-4">Ticket</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th>Reported</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.MaintenanceRequests ?? new List<PropertyLeasing.API.Models.MaintenanceRequest>()) {
                        <tr>
                            <td class="px-4 fw-bold">#@m.RequestId</td>
                            <td class="text-muted">@m.Description</td>
                            <td><span class="badge text-orange">@m.Status</span></td>
                            <td class="text-muted">@m.ReportedAt.ToString("MMM d, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>