@model IEnumerable<PropertyLeasing.API.Models.Tenant>
@{
    ViewData["Title"] = "Tenants";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tenants</h2>
</div>

<div class="apple-table">
    <table class="table mb-0 align-middle">
        <thead>
            <tr>
                <th class="px-4">Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Applications</th>
                <th>Active Leases</th>
                <th>Profile</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="px-4 fw-bold">@t.FullName</td>
                    <td>@t.Email</td>
                    <td>@t.Phone</td>
                    <td><span class="badge text-muted">@(t.Applications?.Count ?? 0)</span></td>
                    <td><span class="badge text-blue">@(t.Leases?.Count ?? 0)</span></td>
                    <td>
                        <a asp-action="Details" asp-route-id="@t.TenantId" class="btn-apple-outline btn-sm text-decoration-none py-1 px-3">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>