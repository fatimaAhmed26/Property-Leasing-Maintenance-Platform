@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mt-4">
            <div class="card-body p-4 p-md-5">
                <h2 class="mb-4">@ViewData["Title"]</h2>

                <p class="text-muted fw-semibold">Use this page to detail your site's privacy policy.</p>

                <div class="text-muted mt-4" style="line-height: 1.8;">
                    <p>
                        This Property Leasing & Maintenance Platform is committed to protecting the privacy and security of our users' data,
                        including personal information for property managers, tenants, and maintenance staff.
                    </p>
                    <p>
                        All user data, lease applications, and maintenance requests are handled in accordance with local data protection
                        regulations and security best practices to ensure strict confidentiality.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>