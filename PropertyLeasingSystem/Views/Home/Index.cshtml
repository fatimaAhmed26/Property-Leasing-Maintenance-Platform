@{
    ViewData["Title"] = "Dashboard";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Dashboard</h2>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <p style="color:var(--apple-gray);font-size:.9rem;margin-top:2px;margin-bottom:0;">
                Welcome back, <strong>@(ViewBag.CurrentUserName)</strong>
            </p>
        }
    </div>
</div>

<div class="row align-items-center py-5 mb-5">
    <div class="col-lg-6">
        @if (User.IsInRole("Tenant"))
        {
            <h1 class="fw-bold mb-3" style="font-size: 3.2rem; letter-spacing: -1.5px;">
                Your Home, <br /><span class="text-blue">Simplified.</span>
            </h1>
            <p class="lead text-muted mb-4" style="max-width: 450px;">
                Manage your residency, track your maintenance requests, and stay updated with your property status effortlessly.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="Applications" asp-action="Submit" class="btn-apple text-decoration-none px-4">Submit Application</a>
            </div>
        }
        @if (User.IsInRole("Property Manager"))
        {
            <h1 class="fw-bold mb-3" style="font-size: 3.2rem; letter-spacing: -1.5px;">
                Manage Your <br /><span class="text-blue">Property Portfolio</span>
            </h1>
            <p class="lead text-muted mb-4" style="max-width: 450px;">
                Streamline leasing, oversee maintenance workflows, and manage tenant relationships from one intuitive hub.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="Properties" asp-action="Index" class="btn-apple text-decoration-none px-4">View Properties</a>
                <a asp-controller="Tenants" asp-action="Index" class="btn-apple-secondary text-decoration-none px-4">Tenants</a>
            </div>
        }
        @if (User.IsInRole("Maintenance Staff"))
        {
            <h1 class="fw-bold mb-3" style="font-size: 3.2rem; letter-spacing: -1.5px;">
                Ready for <br /><span class="text-blue">the Job?</span>
            </h1>
            <p class="lead text-muted mb-4" style="max-width: 450px;">
                Access your assigned work orders, update ticket statuses in real-time, and keep the property in perfect condition.
            </p>
            <div class="d-flex gap-3">
                <a asp-controller="MaintenanceWorkflow" asp-action="Index" class="btn-apple text-decoration-none px-4">View Work Orders</a>
                <a asp-controller="Maintenance" asp-action="Board" class="btn-apple-secondary text-decoration-none px-4">Live Board</a>
            </div>
        }
    </div>
    <div class="col-lg-6 d-none d-lg-block text-center">
        <img src="~/images/dashboard-graphic.png.jpg" class="img-fluid" style="max-width: 80%;" alt="Dashboard Illustration" />
    </div>
    
</div>

<!-- Stats Row -->
<div class="row g-3 mb-5">
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card">
            <div class="stat-number ">@ViewBag.AvailableUnits</div>
            <div class="stat-label">Available Units</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card">
            <div class="stat-number ">@ViewBag.ActiveLeases</div>
            <div class="stat-label">Active Leases</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card">
            <div class="stat-number ">@ViewBag.OpenMaintenance</div>
            <div class="stat-label">Open Maintenance</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card">
            <div class="stat-number ">@ViewBag.TotalProperties</div>
            <div class="stat-label">Properties</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-xl">
        <div class="stat-card">
            <div class="stat-number ">@ViewBag.PendingApplications</div>
            <div class="stat-label">Pending Applications</div>
        </div>
    </div>
</div>

@if (User.Identity?.IsAuthenticated ?? false)
{
    <h5 class="mb-3" style="color:var(--apple-gray);font-weight:500;font-size:.82rem;letter-spacing:.5px;text-transform:uppercase;">Quick Actions</h5>
    <div class="row g-3">
        @if (User.IsInRole("Property Manager"))
        {
            <div class="col-6 col-md-3">
                <a asp-controller="Properties" asp-action="Index" class="action-card">
                    <div class="action-icon">&#127970;</div>
                    <strong>Properties</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="LeaseWorkflow" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128203;</div>
                    <strong>Lease Workflow</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Payments" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128176;</div>
                    <strong>Payments</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Tenants" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128101;</div>
                    <strong>Tenants</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="MaintenanceWorkflow" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128295;</div>
                    <strong>Maintenance</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Maintenance" asp-action="Board" class="action-card">
                    <div class="action-icon">&#128225;</div>
                    <strong>Live Board</strong>
                </a>
            </div>
        }

        @if (User.IsInRole("Tenant"))
        {
            <div class="col-6 col-md-3">
                <a asp-controller="Applications" asp-action="Submit" class="action-card">
                    <div class="action-icon">&#128221;</div>
                    <strong>Apply for Unit</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="MaintenanceWorkflow" asp-action="Submit" class="action-card">
                    <div class="action-icon">&#128295;</div>
                    <strong>Submit Request</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="MaintenanceWorkflow" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128202;</div>
                    <strong>My Requests</strong>
                </a>
            </div>
        }

        @if (User.IsInRole("Maintenance Staff"))
        {
            <div class="col-6 col-md-3">
                <a asp-controller="MaintenanceWorkflow" asp-action="Index" class="action-card">
                    <div class="action-icon">&#128295;</div>
                    <strong>My Work Orders</strong>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Maintenance" asp-action="Board" class="action-card">
                    <div class="action-icon">&#128225;</div>
                    <strong>Live Board</strong>
                </a>
            </div>
        }

        <div class="col-6 col-md-3">
            <a asp-controller="PublicLookup" asp-action="MaintenanceLookup" class="action-card">
                <div class="action-icon">&#128269;</div>
                <strong>Track Request</strong>
            </a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5">
        <p style="font-size:1.1rem;color:var(--apple-gray);margin-bottom:28px;">Sign in to access the platform.</p>
        <a asp-controller="Account" asp-action="Login" class="btn-apple me-3 text-decoration-none">Sign In</a>
        <a asp-controller="Account" asp-action="Register" class="btn-apple-outline text-decoration-none">Register</a>
    </div>
}