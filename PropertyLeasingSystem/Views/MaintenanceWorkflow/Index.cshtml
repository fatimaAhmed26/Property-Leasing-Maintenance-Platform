@model IEnumerable<PropertyLeasing.API.Models.MaintenanceRequest>
@using PropertyLeasing.API.Services
@using PropertyLeasing.API.Models
@{
    ViewData["Title"] = "Maintenance Requests";
    var staffList      = ViewBag.StaffList     as List<Staff> ?? new List<Staff>();
    var currentSearch  = ViewBag.CurrentSearch as string     ?? "";
    var currentStatus  = ViewBag.CurrentStatus as string     ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Maintenance Requests</h2>
    @if (User.IsInRole(WorkflowRoles.Tenant))
    {
        <a asp-action="Submit" class="btn btn-primary">Submit Request</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter -->
<form method="get" asp-action="Index" class="mb-4">
    <div class="row g-2 align-items-end">

        <div class="col-md-5">
            <label class="form-label fw-semibold">Search</label>
            <div class="input-group">
                <span class="input-group-text">&#128269;</span>
                <input type="text"
                       name="search"
                       value="@currentSearch"
                       class="form-control"
                       placeholder="Search by ticket #, tenant name, or description..." />
            </div>
        </div>

        <div class="col-md-3">
            <label class="form-label fw-semibold">Filter by Status</label>
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="@MaintenanceStatuses.Submitted"
                        selected="@(currentStatus == MaintenanceStatuses.Submitted)">
                    Submitted
                </option>
                <option value="@MaintenanceStatuses.Assigned"
                        selected="@(currentStatus == MaintenanceStatuses.Assigned)">
                    Assigned
                </option>
                <option value="@MaintenanceStatuses.InProgress"
                        selected="@(currentStatus == MaintenanceStatuses.InProgress)">
                    In Progress
                </option>
                <option value="@MaintenanceStatuses.Resolved"
                        selected="@(currentStatus == MaintenanceStatuses.Resolved)">
                    Resolved
                </option>
                <option value="@MaintenanceStatuses.Closed"
                        selected="@(currentStatus == MaintenanceStatuses.Closed)">
                    Closed
                </option>
            </select>
        </div>

        <div class="col-md-4 d-flex gap-2 align-items-end">
            <button type="submit" class="btn btn-primary w-100">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
        </div>

    </div>
</form>

<!-- Results count -->
<p class="text-muted small mb-2">
    Showing <strong>@Model.Count()</strong> request(s)
    @if (!string.IsNullOrWhiteSpace(currentSearch))
    {
        <span> matching "<strong>@currentSearch</strong>"</span>
    }
    @if (!string.IsNullOrWhiteSpace(currentStatus))
    {
        <span> with status <strong>@currentStatus</strong></span>
    }
</p>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Ticket #</th>
                <th>Tenant</th>
                <th>Unit</th>
                <th>Description</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Reported</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>#@r.RequestId</td>
                    <td>@r.Tenant?.FullName</td>
                    <td>@r.Unit?.UnitNumber</td>
                    <td>@r.Description</td>
                    <td>
                        @{
                            var priorityClass = r.Priority switch
                            {
                                "High"   => "bg-danger",
                                "Medium" => "bg-warning text-dark",
                                _        => "bg-secondary"
                            };
                        }
                        <span class="badge @priorityClass">@r.Priority</span>
                    </td>
                    <td>
                        @{
                            var statusClass = r.Status switch
                            {
                                MaintenanceStatuses.Submitted  => "bg-secondary",
                                MaintenanceStatuses.Assigned   => "bg-info text-dark",
                                MaintenanceStatuses.InProgress => "bg-warning text-dark",
                                MaintenanceStatuses.Resolved   => "bg-success",
                                MaintenanceStatuses.Closed     => "bg-dark",
                                _                              => "bg-light text-dark"
                            };
                        }
                        <span class="badge @statusClass">@r.Status</span>
                    </td>
                    <td>@r.ReportedAt.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (User.IsInRole(WorkflowRoles.PropertyManager) &&
                             r.Status == MaintenanceStatuses.Submitted)
                        {
                            <form asp-action="Assign" method="post"
                                  class="d-inline d-flex gap-1 align-items-center">
                                <input type="hidden" name="id" value="@r.RequestId" />
                                <select name="staffId"
                                        class="form-select form-select-sm"
                                        style="width:auto;" required>
                                    <option value="">Select staff</option>
                                    @foreach (var s in staffList)
                                    {
                                        <option value="@s.StaffId">
                                            @s.FullName (@s.SkillType)
                                        </option>
                                    }
                                </select>
                                <button class="btn btn-sm btn-outline-info">Assign</button>
                            </form>
                        }
                        @if (User.IsInRole(WorkflowRoles.MaintenanceStaff))
                        {
                            @if (r.Status == MaintenanceStatuses.Assigned)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.RequestId" />
                                    <input type="hidden" name="nextStatus"
                                           value="@MaintenanceStatuses.InProgress" />
                                    <button class="btn btn-sm btn-warning">Start</button>
                                </form>
                            }
                            @if (r.Status == MaintenanceStatuses.InProgress)
                            {
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.RequestId" />
                                    <input type="hidden" name="nextStatus"
                                           value="@MaintenanceStatuses.Resolved" />
                                    <button class="btn btn-sm btn-success">Resolve</button>
                                </form>
                            }
                        }
                        @if ((User.IsInRole(WorkflowRoles.PropertyManager) ||
                              User.IsInRole(WorkflowRoles.Tenant)) &&
                             r.Status == MaintenanceStatuses.Resolved)
                        {
                            <form asp-action="Close" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@r.RequestId" />
                                <button class="btn btn-sm btn-dark">Close</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        No maintenance requests found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>