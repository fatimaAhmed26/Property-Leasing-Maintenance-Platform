@model PropertyLeasing.API.DTOs.SubmitMaintenanceRequestDto
@{
    ViewData["Title"] = "Submit Maintenance Request";
    var tenantUnits = ViewBag.TenantUnits as List<PropertyLeasing.API.Models.Unit> ?? new List<PropertyLeasing.API.Models.Unit>();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h2 class="mb-4">Submit Maintenance Request</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="apple-card">
            <form asp-action="Submit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="UnitId" class="form-label fw-semibold">Property Unit</label>
                    @if (tenantUnits.Any())
                    {
                        <select asp-for="UnitId" class="form-select">
                            <option value="">-- Select your unit --</option>
                            @foreach (var u in tenantUnits)
                            {
                                // Check if property name exists to avoid empty parentheses
                                string propertyDisplay = u.Property != null ? $" ({u.Property.PropertyName})" : "";

                                <option value="@u.UnitId">
                                    Unit @u.UnitNumber@propertyDisplay
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <input asp-for="UnitId" class="form-control" type="number" placeholder="Enter Unit ID" />
                    }
                    <span asp-validation-for="UnitId" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold">Issue Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="Please describe the maintenance issue in detail..."></textarea>
                    <span asp-validation-for="Description" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Priority" class="form-label fw-semibold">Priority Level</label>
                    <select asp-for="Priority" class="form-select">
                        <option value="">-- Select Priority --</option>
                        <option value="Low">Low (Non-urgent repairs)</option>
                        <option value="Medium">Medium (Affects daily living)</option>
                        <option value="High">High (Emergency, leaks, no power)</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="d-flex gap-3 pt-2">
                    <button type="submit" class="btn-apple px-4">Submit Request</button>
                    <a asp-action="Index" class="btn-apple-outline px-4 text-decoration-none">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}