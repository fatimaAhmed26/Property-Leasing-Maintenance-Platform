@model PropertyLeasing.API.Models.Unit
@{
    ViewData["Title"] = "Edit Unit";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="mb-4">
            <h2 class="mb-1">Edit Unit</h2>
            <p class="text-muted mb-0">Property: <strong>@Model.Property?.PropertyName</strong></p>
        </div>

        <div class="apple-card">
            <form asp-action="EditUnit" method="post">
                <input type="hidden" asp-for="UnitId" />
                <input type="hidden" asp-for="PropertyId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-4">
                    <label asp-for="UnitNumber" class="form-label fw-semibold">Unit Number</label>
                    <input asp-for="UnitNumber" class="form-control" />
                    <span asp-validation-for="UnitNumber" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RentAmount" class="form-label fw-semibold">Rent Amount / Month</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">$</span>
                        <input asp-for="RentAmount" class="form-control border-start-0" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="RentAmount" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Size" class="form-label fw-semibold">Size (sqft/sqm)</label>
                    <input asp-for="Size" class="form-control" />
                    <span asp-validation-for="Size" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Amenities" class="form-label fw-semibold">Amenities</label>
                    <input asp-for="Amenities" class="form-control" placeholder="e.g. WiFi, Parking, Gym" />
                    <span asp-validation-for="Amenities" class="text-red mt-1 d-block" style="font-size: 0.85rem;"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check custom-checkbox">
                        <input asp-for="IsAvailable" class="form-check-input" style="cursor: pointer;" />
                        <label asp-for="IsAvailable" class="form-check-label fw-semibold" style="cursor: pointer;">
                            Unit is Available for Rent
                        </label>
                    </div>
                </div>

                <div class="d-flex gap-3 pt-2 border-top mt-4">
                    <button type="submit" class="btn-apple px-4 mt-3">Save Changes</button>
                    <a asp-action="Units" asp-route-propertyId="@Model.PropertyId" class="btn-apple-secondary text-decoration-none px-4 mt-3">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}