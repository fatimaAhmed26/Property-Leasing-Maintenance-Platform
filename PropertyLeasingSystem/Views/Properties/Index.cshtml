@model IEnumerable<PropertyLeasing.API.Models.Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Properties</h2>
    <a asp-action="Create" class="btn-apple text-decoration-none">+ Add Property</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="row g-4">
    @foreach (var p in Model)
    {
        <div class="col-md-4">
            <div class="apple-card h-100 p-4 d-flex flex-column">
                <h5 class="fw-bold mb-1">@p.PropertyName</h5>
                <p class="text-muted small mb-3">@p.Address, @p.City</p>
                <div class="d-flex gap-2 mb-4">
                    <span class="badge text-muted">@p.PropertyType</span>
                </div>

                <div class="d-flex justify-content-between mb-4 border-top pt-3">
                    <div class="text-center">
                        <div class="fw-bold">@(p.Units?.Count ?? 0)</div>
                        <small class="text-muted text-uppercase" style="font-size: 0.65rem;">Units</small>
                    </div>
                    <div class="text-center">
                        <div class="fw-bold text-green">@(p.Units?.Count(u => u.IsAvailable) ?? 0)</div>
                        <small class="text-muted text-uppercase" style="font-size: 0.65rem;">Available</small>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-auto">
                    <a asp-action="Units" asp-route-propertyId="@p.PropertyId" class="btn-apple-outline btn-sm flex-grow-1 text-center text-decoration-none py-1 px-2">Manage</a>
                    <a asp-action="Edit" asp-route-id="@p.PropertyId" class="btn-apple-secondary btn-sm flex-grow-1 text-center text-decoration-none py-1 px-2">Edit</a>

                    <button type="button" data-bs-toggle="modal" data-bs-target="#deleteModal_@p.PropertyId" class="btn-apple-danger btn-sm flex-grow-1 text-center py-1 px-2">Delete</button>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal_@p.PropertyId" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content p-4" style="border-radius: var(--radius-lg); border: none; box-shadow: var(--shadow-lg); background: var(--apple-card);">

                    <div class="text-center mb-4">
                        <h1 class="text-red mb-2" style="font-size: 3rem; line-height: 1;">&#9888;</h1>
                        <h3 class="fw-bold mb-1">Delete Property</h3>
                        <p class="text-muted mb-0">Are you absolutely sure you want to do this?</p>
                    </div>

                    <div class="alert alert-danger text-center mb-4 px-3 py-2" style="font-size: 0.9rem;">
                        <strong>Warning:</strong> Deleting this property will permanently remove it and <strong>all @(p.Units?.Count ?? 0) associated units</strong> from the database.
                    </div>

                    <div class="mb-4">
                        <div class="row border-bottom py-2 mx-0">
                            <div class="col-4 text-muted fw-semibold px-0">Name</div>
                            <div class="col-8 fw-bold text-dark text-end px-0">@p.PropertyName</div>
                        </div>
                        <div class="row border-bottom py-2 mx-0">
                            <div class="col-4 text-muted fw-semibold px-0">Address</div>
                            <div class="col-8 text-dark text-end px-0">@p.Address, @p.City</div>
                        </div>
                        <div class="row py-2 mx-0">
                            <div class="col-4 text-muted fw-semibold px-0">Type</div>
                            <div class="col-8 text-end px-0"><span class="badge text-muted">@p.PropertyType</span></div>
                        </div>
                    </div>

                    <form asp-action="Delete" asp-route-id="@p.PropertyId" method="post" class="m-0">
                        <div class="d-flex gap-3">
                            <button type="button" class="btn-apple-secondary w-50" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn-apple-danger-solid w-50">Yes, Delete</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12">
            <p class="text-muted">No properties found. <a asp-action="Create">Add the first one.</a></p>
        </div>
    }
</div>