@{
    ViewData["Title"] = "Maintenance Board (Live)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Live Maintenance Board</h2>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">
            Real-time updates via SignalR &mdash; <span id="connectionStatus" class="badge text-orange">Connecting...</span>
        </p>
    </div>
    <button id="refreshBtn" class="btn-apple-outline" onclick="loadRequests()">Refresh</button>
</div>

<div id="boardContainer">
    <div class="text-center py-5">
        <div class="spinner-border" style="color: var(--apple-blue);" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted fw-semibold">Syncing maintenance requests...</p>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const HUB_URL = "/hubs/maintenance";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl(HUB_URL)
            .withAutomaticReconnect()
            .build();

        connection.onreconnecting(() => {
            document.getElementById("connectionStatus").textContent = "Reconnecting...";
            document.getElementById("connectionStatus").className = "badge text-orange";
        });

        connection.onreconnected(() => {
            document.getElementById("connectionStatus").textContent = "Connected";
            document.getElementById("connectionStatus").className = "badge text-green";
        });

        connection.onclose(() => {
            document.getElementById("connectionStatus").textContent = "Disconnected";
            document.getElementById("connectionStatus").className = "badge text-red";
        });

        // Listen for status updates broadcast from the API hub
        connection.on("MaintenanceStatusUpdated", function (requestId, newStatus) {
            const row = document.querySelector(`tr[data-id="${requestId}"]`);
            if (row) {
                const statusCell = row.querySelector(".status-cell");
                if (statusCell) {
                    statusCell.innerHTML = statusBadge(newStatus);
                }
                // flash the row using a custom transition instead of bootstrap warning
                row.style.backgroundColor = "rgba(0, 113, 227, 0.1)";
                setTimeout(() => row.style.backgroundColor = "", 2000);
            } else {
                loadRequests(); // If it's not in the table, reload the board
            }
        });

        connection.on("NewMaintenanceRequest", function () {
            loadRequests();
        });

        async function startConnection() {
            try {
                await connection.start();
                await connection.invoke("JoinMaintenanceBoard");
                document.getElementById("connectionStatus").textContent = "Connected";
                document.getElementById("connectionStatus").className = "badge text-green";
            } catch (err) {
                document.getElementById("connectionStatus").textContent = "Error";
                document.getElementById("connectionStatus").className = "badge text-red";
                console.error("SignalR connection error:", err);
            }
        }

        // Map statuses to your custom CSS utility colors
        function statusBadge(status) {
            const map = {
                "Submitted": "text-muted",
                "Assigned": "text-blue",
                "InProgress": "text-orange",
                "Resolved": "text-green",
                "Closed": "text-purple"
            };
            const cls = map[status] || "text-muted";
            return `<span class="badge ${cls}">${status}</span>`;
        }

        // Map priorities to your custom CSS utility colors
        function priorityBadge(priority) {
            const map = {
                "High": "text-red",
                "Medium": "text-orange",
                "Low": "text-muted"
            };
            const cls = map[priority] || "text-muted";
            return `<span class="badge ${cls}">${priority}</span>`;
        }

        async function loadRequests() {
            try {
                const resp = await fetch("/Maintenance/GetRequests");
                if (!resp.ok) {
                    document.getElementById("boardContainer").innerHTML =
                        `<div class="alert alert-warning">Could not load maintenance data (${resp.status}).</div>`;
                    return;
                }
                const data = await resp.json();
                renderBoard(data);
            } catch (e) {
                document.getElementById("boardContainer").innerHTML =
                    `<div class="alert alert-danger">Could not load maintenance requests. Please refresh the page.</div>`;
            }
        }

        function renderBoard(requests) {
            if (!requests || requests.length === 0) {
                document.getElementById("boardContainer").innerHTML =
                    '<p class="text-muted text-center py-4">No maintenance requests found.</p>';
                return;
            }

            const columns = ["Submitted", "Assigned", "InProgress", "Resolved", "Closed"];
            const groups = {};
            columns.forEach(c => groups[c] = []);
            requests.forEach(r => {
                if (groups[r.status] !== undefined) groups[r.status].push(r);
                else groups["Submitted"].push(r);
            });

            // Build the Kanban Board
            let html = '<div class="row g-3">';
            columns.forEach(col => {
                const items = groups[col];
                html += `<div class="col-12 col-md-6 col-xl">
                    <div class="h-100 p-2" style="background: rgba(0,0,0,0.02); border-radius: var(--radius-lg); border: 1px dashed var(--apple-border);">
                        <div class="d-flex justify-content-between align-items-center mb-3 px-2 pt-2">
                            <strong class="text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">${col === "InProgress" ? "In Progress" : col}</strong>
                            <span class="badge text-muted" style="background: transparent; border: none;">${items.length}</span>
                        </div>
                        <div>`;

                if (items.length === 0) {
                    html += `<p class="text-muted text-center small mt-4" style="opacity: 0.5;">No tickets</p>`;
                }

                // Build the individual tickets using custom apple-card styling
                items.forEach(r => {
                    html += `<div class="apple-card mb-2" data-id="${r.requestId || r.id || ''}" style="padding: 16px; cursor: default;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <strong style="font-size: 0.9rem;">#${r.requestId || r.id}</strong>
                            ${priorityBadge(r.priority)}
                        </div>
                        <p class="small mb-3 text-muted lh-sm">${(r.description || '').substring(0, 80)}...</p>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2" style="border-color: var(--apple-border) !important;">
                            <small class="text-blue fw-semibold">Unit ${r.unitId || ''}</small>
                        </div>
                    </div>`;
                });
                html += `</div></div></div>`;
            });
            html += '</div>';

            // Build the Data Table using apple-table
            html += `<h5 class="mt-5 mb-3 text-muted text-uppercase fw-bold" style="font-size: .85rem; letter-spacing: .5px;">All Requests Log</h5>
            <div class="apple-table">
            <table class="table mb-0">
                <thead>
                    <tr><th>#</th><th>Unit</th><th>Description</th><th>Priority</th><th>Status</th><th>Reported</th></tr>
                </thead>
                <tbody>`;

            requests.forEach(r => {
                html += `<tr data-id="${r.requestId || r.id}">
                    <td><strong>#${r.requestId || r.id}</strong></td>
                    <td class="text-blue fw-semibold">${r.unitId || ''}</td>
                    <td class="text-muted">${(r.description || '').substring(0, 60)}${(r.description || '').length > 60 ? '...' : ''}</td>
                    <td>${priorityBadge(r.priority)}</td>
                    <td class="status-cell">${statusBadge(r.status)}</td>
                    <td class="text-muted">${r.reportedAt ? new Date(r.reportedAt).toLocaleDateString() : ''}</td>
                </tr>`;
            });
            html += '</tbody></table></div>';

            document.getElementById("boardContainer").innerHTML = html;
        }

        startConnection();
        loadRequests();
    </script>
}
