@model PropertyLeasing.API.DTOs.MaintenanceLookupResultDto
@{
    ViewData["Title"] = "Maintenance Request Status";
    Layout = "_Layout";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="apple-card p-4 p-md-5">

            <div class="text-center mb-4 pb-3 border-bottom">
                <div class="text-green mb-2" style="font-size: 3.5rem; line-height: 1;">&#10003;</div>
                <h3 class="fw-bold mb-1">Request Found</h3>
                <p class="text-muted mb-0">Here is the latest information on your ticket.</p>
            </div>

            <div class="mb-4">
                <div class="row border-bottom py-2 mx-0">
                    <div class="col-4 text-muted fw-semibold px-0">Tenant</div>
                    <div class="col-8 fw-bold text-dark text-end px-0">@Model.TenantName</div>
                </div>
                <div class="row border-bottom py-3 mx-0">
                    <div class="col-4 text-muted fw-semibold px-0">Description</div>
                    <div class="col-8 text-end px-0 text-muted" style="white-space: normal;">@Model.Description</div>
                </div>
                <div class="row border-bottom py-2 mx-0">
                    <div class="col-4 text-muted fw-semibold px-0">Priority</div>
                    <div class="col-8 text-end px-0">
                        @{
                            var priorityClass = Model.Priority == "High" ? "text-red" :
                            Model.Priority == "Medium" ? "text-orange" : "text-muted";
                        }
                        <span class="badge @priorityClass">@Model.Priority</span>
                    </div>
                </div>
                <div class="row border-bottom py-2 mx-0">
                    <div class="col-4 text-muted fw-semibold px-0">Status</div>
                    <div class="col-8 text-end px-0">
                        @{
                            var statusClass = Model.Status switch
                            {
                                "Submitted" => "text-muted",
                                "Assigned" => "text-blue",
                                "In Progress" => "text-orange",
                                "InProgress" => "text-orange",
                                "Resolved" => "text-green",
                                "Closed" => "text-purple",
                                _ => "text-blue"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                    </div>
                </div>
                <div class="row py-2 mx-0">
                    <div class="col-4 text-muted fw-semibold px-0">Reported</div>
                    <div class="col-8 text-end px-0 text-muted">@Model.ReportedAt.ToString("MMM d, yyyy - HH:mm")</div>
                </div>
            </div>

            @if (Model.Logs != null && Model.Logs.Any())
            {
                <div class="mt-4 pt-3 border-top">
                    <h5 class="fw-bold mb-3">Activity Log</h5>
                    <div class="px-2">
                        @foreach (var log in Model.Logs)
                        {
                            <div class="mb-3 pb-3 border-bottom border-light">
                                <div class="fw-semibold text-dark">@log.ActionTaken</div>
                                <div class="text-muted small mt-1">
                                    <span class="fw-semibold">Started:</span> @log.WorkStarted.ToString("MMM d, yyyy - HH:mm")
                                    @if (log.WorkCompleted.HasValue)
                                    {
                                        <br />
                                        <span class="fw-semibold">Completed:</span>
 
                                        @log.WorkCompleted.Value.ToString("MMM d, yyyy - HH:mm")
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="mt-4 pt-2 text-center">
                <a asp-controller="PublicLookup" asp-action="MaintenanceLookup" class="btn-apple-secondary text-decoration-none px-5 py-2">Search Again</a>
            </div>

        </div>
    </div>
</div>
